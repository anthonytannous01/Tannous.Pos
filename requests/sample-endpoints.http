@baseUrl = http://localhost:8080
@apiVersion = 1.0
@deviceId = dev-terminal-01
@idempotencyKey = 11111111-1111-1111-1111-111111111111
@accessToken = PASTE_ACCESS_TOKEN_HERE

### List orders (versioned route)
GET {{baseUrl}}/api/v{{apiVersion}}/orders
Authorization: Bearer {{accessToken}}
Device-Id: {{deviceId}}
Accept: application/json

### Create order (versioned route)
POST {{baseUrl}}/api/v{{apiVersion}}/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json
Device-Id: {{deviceId}}
Idempotency-Key: {{idempotencyKey}}

{
  "items": [
    {
      "menuItemId": "00000000-0000-0000-0000-000000000001",
      "quantity": 1
    }
  ]
}

### Catalog menu items (unversioned route currently present in API)
GET {{baseUrl}}/api/catalog/menu-items
Authorization: Bearer {{accessToken}}
Device-Id: {{deviceId}}
Accept: application/json

### Read customers with pagination (unversioned route currently present in API)
GET {{baseUrl}}/api/customers?page=1&pageSize=20&q=&sort=name&dir=asc
Authorization: Bearer {{accessToken}}
Device-Id: {{deviceId}}
Accept: application/json

### Sync pull
GET {{baseUrl}}/api/sync/pull
Authorization: Bearer {{accessToken}}
Device-Id: {{deviceId}}
Accept: application/json

