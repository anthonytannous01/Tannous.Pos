appsettings.Development.json

# Android / Gradle
mobile/.gradle/
mobile/**/build/
mobile/**/.transforms/
mobile/local.properties
mobile/app/google-services.json

# Secrets / environment
# Signing material must never be committed. These patterns are recursive on purpose:
# the previous 'mobile/*.jks' only matched the mobile/ directory itself, so the release
# keystore in mobile/keystore/ was tracked despite looking ignored.
*.jks
*.keystore
*.pfx
*.p12
*.jceks
mobile/keystore/
.env
secrets/

# Scratch
commit-msg.txt
commit-msg-*.txt

# Receipt captures from scripts/fake-printer.ps1 (regenerate as needed)
captures/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
.vscode/
