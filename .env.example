# Tannous POS Environment Variables Example
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ============================================
# Database Configuration
# ============================================
# PostgreSQL connection string for the application
# Format: Host=hostname;Port=port;Database=dbname;Username=user;Password=password
DB_CONNECTION_STRING=Host=localhost;Port=5432;Database=TannousPOS;Username=postgres;Password=postgres

# PostgreSQL container environment variables (used by docker-compose)
POSTGRES_DB=TannousPOS
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ============================================
# JWT Configuration
# ============================================
# JWT signing key (MUST be at least 32 characters for HS256)
# Generate a secure key: openssl rand -base64 32
JWT_KEY=your-super-secret-key-with-at-least-32-characters-minimum-for-jwt-signing

# JWT token issuer (optional, defaults to TannousPOS)
JWT_ISSUER=TannousPOS

# JWT token audience (optional, defaults to TannousPOS)
JWT_AUDIENCE=TannousPOS

# Access token expiry in minutes (optional, defaults to 15)
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15

# Refresh token expiry in days (optional, defaults to 30)
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# ============================================
# ASP.NET Core Configuration
# ============================================
# Environment: Development, Staging, Production
ASPNETCORE_ENVIRONMENT=Development

# URLs the API will listen on (comma-separated)
# Use 0.0.0.0 to listen on all interfaces (for Docker)
ASPNETCORE_URLS=http://0.0.0.0:7000

# ============================================
# Admin User Seeding (Development Only)
# ============================================
# These variables are only used in Development environment
# If not set, admin seeding will be skipped
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=SecurePass123!
SEED_ADMIN_FIRSTNAME=Admin
SEED_ADMIN_LASTNAME=User
SEED_ADMIN_EMAIL=admin@tannouspos.com

# ============================================
# docker-compose.prod.yml (optional)
# ============================================
# POSTGRES_PASSWORD=  (required in prod compose; no default)
# JWT_EXPIRY_MINUTES=240
# CORS_ORIGIN_1=https://app.example.com
# CORS_ORIGIN_2=https://admin.example.com
