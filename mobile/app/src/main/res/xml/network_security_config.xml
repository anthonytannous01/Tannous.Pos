<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- Allow cleartext traffic for localhost and emulator -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Add your development machine's IP -->
        <domain includeSubdomains="false">192.168.0.121</domain>
        <domain includeSubdomains="false">172.30.208.1</domain>
        <domain includeSubdomains="false">192.168.0.125</domain>
    </domain-config>
    
    <!-- For debug builds, allow all cleartext traffic -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>

