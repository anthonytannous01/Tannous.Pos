{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "REPLACE_WITH_ENV_VAR_DB_CONNECTION_STRING"
  },
  "Db": {
    "CommandTimeoutSeconds": 30,
    "Retry": { "MaxRetries": 5, "MaxDelaySeconds": 10 }
  },
  "Jwt": {
    "Key": "REPLACE_WITH_ENV_VAR_JWT_KEY",
    "Issuer": "TannousPOS",
    "Audience": "TannousPOS",
    "AccessTokenExpiryInMinutes": "15",
    "RefreshTokenExpiryInDays": "30"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://tannous-pos.com",
      "https://app.tannous-pos.com"
    ]
  },
  "RateLimiting": {
    "AuthEndpoints": {
      "PermitLimit": 5,
      "Window": "00:01:00"
    },
    "MutationEndpoints": {
      "PermitLimit": 60,
      "Window": "00:01:00"
    }
  }
}
